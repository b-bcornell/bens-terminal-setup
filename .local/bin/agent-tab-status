#!/usr/bin/env python3
"""Set a short, action-oriented title on the current agent terminal."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from typing import Any


MAX_TITLE_LENGTH = 17
MAX_BRANCH_LENGTH = 7


def read_event() -> dict[str, Any]:
    try:
        raw = sys.stdin.read()
        return json.loads(raw) if raw.strip() else {}
    except (json.JSONDecodeError, OSError):
        return {}


def active_branch(event: dict[str, Any]) -> str:
    cwd = str(event.get("cwd") or os.getcwd())
    commands = (
        ["/usr/bin/git", "-C", cwd, "branch", "--show-current"],
        ["/usr/bin/git", "-C", cwd, "rev-parse", "--short=7", "HEAD"],
    )
    for command in commands:
        try:
            value = subprocess.check_output(
                command,
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=2,
            ).strip()
            value = re.sub(r"[\x00-\x20\x7f-\x9f]", "", value)
            if value:
                return value[-MAX_BRANCH_LENGTH:]
        except (OSError, subprocess.SubprocessError):
            pass
    return "no-git"


def title_for(status: str, event: dict[str, Any]) -> str:
    if status == "ready":
        emoji, action = "💬", "prompt"
    elif status == "working":
        emoji, action = "⏳", "wait"
    elif status == "waiting":
        needs_approval = (
            event.get("hook_event_name") == "PermissionRequest"
            or event.get("notification_type") == "permission_prompt"
        )
        emoji, action = ("👍", "approve") if needs_approval else ("🙋", "reply")
    elif status == "done":
        emoji, action = "👀", "review"
    else:
        emoji, action = "🔁", "retry"

    branch = active_branch(event)
    # With a seven-character branch, the longest form is exactly 17 characters.
    return f"{emoji} {branch} {action}"[:MAX_TITLE_LENGTH]


def osc_title(title: str) -> str:
    return f"\x1b]2;{title}\x1b\\"


def tmux_binary() -> str | None:
    candidate = shutil.which("tmux")
    if candidate:
        return candidate
    for candidate in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux"):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def tmux_pane_terminal() -> str | None:
    pane = os.environ.get("TMUX_PANE", "").strip()
    binary = tmux_binary()
    if not pane or not binary:
        return None
    try:
        terminal = subprocess.check_output(
            [binary, "display-message", "-p", "-t", pane, "#{pane_tty}"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=2,
        ).strip()
        if terminal.startswith("/dev/"):
            return terminal
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def find_terminal() -> str | None:
    configured = os.environ.get("AGENT_TAB_TTY", "").strip()
    if configured:
        return configured if configured.startswith("/dev/") else f"/dev/{configured}"

    try:
        fd = os.open("/dev/tty", os.O_WRONLY | os.O_NOCTTY)
        os.close(fd)
        return "/dev/tty"
    except OSError:
        pass

    # Codex hook commands have piped stdio and no controlling TTY. In tmux,
    # resolve the originating pane explicitly instead of walking process TTYs.
    terminal = tmux_pane_terminal()
    if terminal:
        return terminal

    pid = os.getppid()
    for _ in range(8):
        try:
            tty = subprocess.check_output(
                ["/bin/ps", "-o", "tty=", "-p", str(pid)],
                text=True,
                stderr=subprocess.DEVNULL,
            ).strip()
            if tty and tty not in {"??", "?", "-"}:
                return tty if tty.startswith("/dev/") else f"/dev/{tty}"
            parent = subprocess.check_output(
                ["/bin/ps", "-o", "ppid=", "-p", str(pid)],
                text=True,
                stderr=subprocess.DEVNULL,
            ).strip()
            pid = int(parent)
        except (OSError, subprocess.SubprocessError, ValueError):
            break
    return None


def rename_tmux_window(title: str) -> bool:
    pane = os.environ.get("TMUX_PANE", "").strip()
    binary = tmux_binary()
    if not pane or not binary:
        return False
    try:
        result = subprocess.run(
            [binary, "rename-window", "-t", pane, title],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def emit_direct(sequence: str, title: str) -> None:
    # A targeted tmux rename is more reliable than sending OSC through a pane
    # whose foreground TUI may immediately redraw or replace the title.
    if rename_tmux_window(title):
        return

    terminal = find_terminal()
    if terminal:
        try:
            with open(terminal, "w", encoding="utf-8", buffering=1) as tty:
                tty.write(sequence)
                tty.flush()
            return
        except OSError:
            pass


def main() -> int:
    parser = argparse.ArgumentParser()
    # Retained for compatibility with the installed hook commands; not displayed.
    parser.add_argument("--agent")
    parser.add_argument(
        "--status",
        choices=("ready", "working", "waiting", "done", "error"),
        required=True,
    )
    parser.add_argument("--transport", choices=("claude", "codex"), required=True)
    args = parser.parse_args()

    event = read_event()
    title = title_for(args.status, event)
    sequence = osc_title(title)

    if args.transport == "claude":
        print(json.dumps({"terminalSequence": sequence}, ensure_ascii=False))
    else:
        emit_direct(sequence, title)
        print("{}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
